APP_NAME=Buildino
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://buildino.ir
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# No database is required for the public marketing website.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

BUILDINO_NAME="بیلدینو"
BUILDINO_TITLE="بیلدینو | پلتفرم مدیریت هوشمند ساختمان و مجتمع"

# Set these when official contact details and a real mail service are ready.
BUILDINO_CONTACT_PHONE=021-57702
# BUILDINO_CONTACT_EMAIL=
BUILDINO_CONTACT_ADDRESS="قائم مقام فراهانی، کوچه آزادگان، پلاک ۲۵، واحد ۲۳-۲۴"
